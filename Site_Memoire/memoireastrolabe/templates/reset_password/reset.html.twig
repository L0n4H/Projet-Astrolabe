{% extends 'base.html.twig' %}
{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('resetcss') }}
{% endblock %}

{% block title %}Réinitialiser le mot de passe - {{ parent() }}{% endblock %}

{% block body %}
<div class ="row m-5">
    <div class="col d-none d-lg-block">
        <img src="{{asset('/build/images/evenement.png')}}" class="img-fluid rounded" alt="Responsive image">
    </div>
    <div class="col-12 col-lg-6 d-flex justify-content-center ">
        <div id="formReset" class=" d-flex flex-column justify-content-center mx-auto">
        <h1>Réinitialiser votre mot de passe</h1>
            {{ form_start(resetForm) }} 
                <div class="invalid-feedback d-block">
                    {{ form_errors(resetForm.plainPassword.first) }}
                </div>
                {{ form_label(resetForm.plainPassword.first) }}
                {{ form_widget(resetForm.plainPassword.first) }}
                {{ form_label(resetForm.plainPassword.second) }}
                {{ form_widget(resetForm.plainPassword.second) }}

                <button class="btn btn-primary">Réinitialiser</button>
            {{ form_end(resetForm) }}
        </div>
    </div>
</div>
{% endblock %}
