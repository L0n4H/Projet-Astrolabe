{% apply spaceless %}
{% set ressources = {} %}
{% for ressource in listeRessources %}
	{% set evenementsArr = {} %}
	{% for evenement in ressource.getVisibleEvenements %}
		{% set etiquettes =  { } %}
		{% for etiquette in evenement.getVisibleEtiquettes %}
			{%  set etiquetteArray ={(etiquette.getId): {'id':etiquette.getId, 'motsCles':etiquette.getMotsCles,'url':  (absolute_url(path('detail_etiquette', {'id' : etiquette.getId}))) } }   %}
			{% set etiquettes = etiquettes|merge(etiquetteArray) %}
		{% endfor %}
		{% if evenement.getVisibleLieu is not null %}
			{% set lieu = {'ville':(evenement.getVisibleLieu.getVille),'CP':(evenement.getVisibleLieu.getCP),'adresse':(evenement.getVisibleLieu.getAdresse),'nomBatiment':(evenement.getVisibleLieu.getNomBatiment),'url':  (absolute_url(path('detail_lieu', {'id' : evenement.getVisibleLieu.getId}))) }%}
		{% else %}
			{% set lieu = null %}
		{% endif %}
		{% set passages =  { } %}
		{% for passage in evenement.getVisiblePassages %}
			{% if passage.getVisibleGroupe is not null %}
				{% set etiquettes = { } %}
				{% for etiquette in passage.getVisibleGroupe.getVisibleEtiquettes %}
					{%  set etiquetteArray ={(etiquette.getId): {'id':etiquette.getId, 'motsCles':etiquette.getMotsCles,'url':  (absolute_url(path('detail_etiquette', {'id' : etiquette.getId}))) } }   %}
					{% set etiquettes = etiquettes|merge(etiquetteArray) %}
				{% endfor %}
				{% set genres = { } %}
				{% for genre in passage.getVisibleGroupe.getVisibleGenresMusicaux %}
					{%  set genreArray ={(genre.getId) : {'id':genre.getId, 'nom':genre.getNom,'url':  (absolute_url(path('detail_genreMusical', {'id' : genre.getId}))) }} %}
					{% set genres = genres|merge(genreArray) %}
				{% endfor %}
				{% set labels = { } %}
				{% for label in passage.getVisibleGroupe.getVisibleLabels %}
					{%  set labelArray ={(label.getId) : {'id':label.getId, 'nom':label.getNom,'url':  (absolute_url(path('detail_label', {'id' : label.getId}))) }}%}
					{% set labels = labels|merge(labelArray) %}
				{% endfor %}
				{% set membres = { } %}
				{% for membre in passage.getVisibleGroupe.getVisibleMembres %}
					{% set etiquettes = { } %}
					{% if membre.getVisibleMusicien is not null %}
						{% for etiquette in membre.getVisibleMusicien.getVisibleEtiquettes %}
							{%  set etiquetteArray ={(etiquette.getId): {'id':etiquette.getId, 'motsCles':etiquette.getMotsCles,'url':  (absolute_url(path('detail_etiquette', {'id' : etiquette.getId}))) } }   %}
							{% set etiquettes = etiquettes|merge(etiquetteArray) %}
						{% endfor %}
						{%  set musicien ={'id':membre.getVisibleMusicien.getId, 'nom':membre.getVisibleMusicien.getNom,'prenom':membre.getVisibleMusicien.getPrenom,'nomScene':membre.getVisibleMusicien.getNomScene,'dateNaissance':membre.getVisibleMusicien.getDateNaissance,'lienImage':membre.getVisibleMusicien.getLienImage,
						'image':membre.getVisibleMusicien.getImage is not null ? ((absolute_url(url('home')))~(vich_uploader_asset(membre.getVisibleMusicien, 'imageFile')) ): '', 
						'etiquettes':etiquettes,'url':  (absolute_url(path('detail_musicien', {'id' : membre.getVisibleMusicien.getId}))) } %}
					{% else %}
						{%  set musicien ={} %}
					{% endif %}
					{%  set instruments ={} %}
					{% for instrument in membre.getVisibleInstruments %}
						{%  set instrumentArray ={(instrument.getId) : {'id':instrument.getId, 'nom':instrument.getNom,'url':  (absolute_url(path('detail_instrument', {'id' : instrument.getId}))) }} %}
						{% set instruments = instruments|merge(instrumentArray) %}
					{% endfor %}
					{%  set membreArray ={(membre.getId) : {'id':membre.getId, 'actif':membre.getActif,'musicien':musicien,'instruments' : instruments,'url':  (absolute_url(path('detail_membre', {'id' : membre.getId}))) }} %}
					{% set membres = membres|merge(membreArray) %}
				{% endfor %}
				{% set groupe = 
					{
						'id' : passage.getVisibleGroupe.getId,
						'dateCreation':passage.getVisibleGroupe.getDateCreation,
						'biographie':passage.getVisibleGroupe.getBiographie,
						'lienImage':passage.getVisibleGroupe.getLienImage,
						'image':passage.getVisibleGroupe.getImage is not null ? ((absolute_url(url('home')))~(vich_uploader_asset(passage.getVisibleGroupe, 'imageFile')) ): '', 
						'etiquettes':etiquettes,
						'genreMusicaux':genres,
						'labels':labels,
						'membres':membres,
						'nationalite': passage.getVisibleGroupe.getVisibleNationalite is not null ? passage.getVisibleGroupe.getVisibleNationalite.getNom : null,
						'url':  (absolute_url(path('detail_groupe', {'id' : passage.getVisibleGroupe.getId}))) }%}
			{% else %}
				{% set groupe = {} %}
			{% endif %}
			{%  set passageArray ={ 
				(passage.getId) :
				{
					'id':passage.getId, 
					'dateDebut':passage.getDateDebut is not null ? passage.getDateDebut.format("d-m-Y H:i") : null, 
					'dateFin':passage.getDateFin is not null ? passage.getDateFin.format("d-m-Y H:i") : null ,
					'groupe':groupe,
					'url':  (absolute_url(path('detail_passage', {'id' : passage.getId}))) 
				}} %}
			{% set passages = passages|merge(passageArray) %}
		{% endfor %}
		{% set evenementArr =  {'id' : (evenement.getId),"dateDebut": (evenement.getDateDebut.format("d-m-Y H:i")),"dateFin": (evenement.getDateFin.format("d-m-Y H:i")),"description": (evenement.getDescription),"titre": (evenement.getTitre),'etiquettes' : etiquettes,'lieu':lieu,'passages':passages,'url':  (absolute_url(path('detail_api_evenement', {'id' : evenement.getId}))) } %}
		{% set evenementsArr = evenementsArr|merge(evenementArr) %}
	{% endfor %}
	{% set etiquettesRess = { } %}
	{% for etiquette in ressource.getVisibleEtiquettes %}
		{%  set etiquetteArray = {(etiquette.getId):{'id':etiquette.getId, 'motsCles':etiquette.getMotsCles,'url':  (absolute_url(path('detail_etiquette', {'id' : etiquette.getId}))) } }   %}
		{% set etiquettesRess = etiquettesRess|merge(etiquetteArray) %}
	{% endfor %}
	{% set groupes = { } %}
	{% for groupe in ressource.getVisibleGroupes %}
		{% set groupeArray = {(groupe.getId):{'id':groupe.getId,'dateCreation':groupe.getDateCreation,'biographie':groupe.getBiographie,'image':groupe.getImage,'nationalite':groupe.getVisibleNationalite is not null ? groupe.getVisibleNationalite.getNom : null ,'url':(absolute_url(path('detail_groupe',{'id':groupe.getId})))}} %}
		{% set groupes = groupes|merge(groupeArray) %}
	{% endfor %}
	{% set ressourceArr =  {(ressource.getId) :{'id' : (ressource.getId),"lien": (ressource.getLien),'titre': (ressource.getTitre),'image':ressource.getNom is not null ? ((absolute_url(url('home')))~(vich_uploader_asset(ressource, 'file')) ): '',"etiquettes": etiquettesRess,"evenements" : evenementsArr,"groupes": groupes,"credits" : ressource.getCredits,'type': (ressource.getType.getLabel),'url':  (absolute_url(path('detail_ressource', {'id' : ressource.getId})))} } %}
	{% set ressources = ressources|merge(ressourceArr) %}
{% endfor %}
{{ ressources|unescape|raw }}
{% endapply %}
